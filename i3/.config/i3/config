# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod1 Mod4
set $mod Mod1

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango: Input Nerd Font 12

title_align center
show_marks yes

# Theme colors: read from xrdb (theme.*, set by bin/theme), Nord as the fallback
set_from_resource $accent    theme.accent   #5E81AC
set_from_resource $indicator theme.cyan     #88C0D0
set_from_resource $inactive  theme.altblack #4C566A
set_from_resource $unfocused theme.black    #3B4252
client.focused     #ECEFF4      #5E81AC     #E5E9F0    $indicator    $accent
client.focused_inactive   #4C556A     #ECEFF4    #2E3440     $inactive     $inactive
client.unfocused   #ECEFF4      #ECEFF4    #171717     $unfocused    $unfocused
client.urgent           #BF616A            #BF616A        #ffffff        #268BD2
client.placeholder      #ECEFF4            #909090        #FFFFFF        #268BD2

# Thin border so the focused window stands out; hidden when it touches the screen edge
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# In fullscreen, only show pop-ups that belong to the fullscreen app
popup_during_fullscreen smart

gaps inner 10
gaps outer 0
# Keep the gaps even with a single window, so the wallpaper frames it
smart_gaps off

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xset s 300 300
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/bin/lock

# Polkit agent: password prompt for GUI apps that need root (pamac, gparted, ...)
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Wallpaper saved by nitrogen (pick one once with `nitrogen`)
exec --no-startup-id nitrogen --restore
# Automount USB drives, with a tray icon
exec --no-startup-id udiskie --tray
# Split new windows along the longer side of the focused one
exec --no-startup-id autotiling
exec --no-startup-id setxkbmap -option "ctrl:swapcaps"
exec --no-startup-id fcitx5
# GTK theme / icons / cursor / font for GTK apps (~/.config/xsettingsd/xsettingsd.conf)
exec --no-startup-id xsettingsd
exec --no-startup-id xfce4-power-manager
exec --no-startup-id copyq
exec --no-startup-id $HOME/.config/i3/bin/compositor -b
# Set displays, then restore colours, then start one bar per screen (in this order).
exec --no-startup-id sh -c "$HOME/.config/i3/bin/display --no-bar; $HOME/.config/i3/bin/theme restore; $HOME/.config/i3/bin/i3bar"
# Workspace names show an icon per app (re-run on i3 restart, it replaces any old copy)
exec_always --no-startup-id $HOME/.config/i3/bin/ws-icons
# Desktop widget (clock, weather, system, now playing)
exec --no-startup-id $HOME/.config/i3/bin/widgets start
exec --no-startup-id nm-applet
exec --no-startup-id mpd
exec --no-startup-id blueman-applet
exec --no-startup-id flameshot
# Notifications (dunst; xfce4-notifyd.service is masked so it can't grab the D-Bus name first)
exec --no-startup-id dunst
# Night light: warmer screen after sunset where we are now (~/.config/redshift/redshift.conf; Super+R changes it)
exec --no-startup-id $HOME/.config/i3/bin/nightlight start
# Warn if the pinned monitor EDID (xorg.conf.d/20-nvidia-connected-monitor.conf) no longer matches the live monitor
# Exits silently when that file is absent, so this is harmless on a laptop.
exec --no-startup-id sh -c "sleep 10; ~/.config/i3/bin/edid-check"
# rofi/menu entries for the AppImages in the AppImage directory (only new or changed apps are re-read)
exec --no-startup-id $HOME/.config/i3/bin/appimage-menu


# Use pactl to adjust volume in PulseAudio.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Detect the laptop backlight device; otherwise use DDC/CI for external displays.
bindsym XF86MonBrightnessUp exec --no-startup-id $HOME/.config/i3/bin/brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id $HOME/.config/i3/bin/brightness down

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# assign
assign [class="libreoffice"] number $ws1

assign [class="jetbrains-toolbox"] number $ws2
assign [class="jetbrains-goland"] number $ws2
assign [class="jetbrains-idea"] number $ws2
assign [class="jetbrains-pycharm"] number $ws2
assign [class="jetbrains-clion"] number $ws2
assign [class="jetbrains-datagrip"] number $ws2
assign [class="jetbrains-webstorm"] number $ws2
assign [class="Netbeans"] number $ws2

assign [class="firefox"] number $ws3
assign [class="FirefoxNightly"] number $ws3
assign [class="Microsoft-edge-dev"] number $ws3
assign [class="Nightly"] number $ws3

assign [class="bilibili"] number $ws4
assign [class="netease-cloud-music"] number $ws4
assign [class="FeelUOwn"] number $ws4

assign [class="Steam"] number $ws5

assign [class="VirtualBox Machine"] number $ws6

assign [class="thunderbird"] number $ws8
assign [class="Qq"] number $ws8
assign [class="TelegramDesktop"] number $ws8
assign [class="obsidian"] number $ws8

# for_window floating settings
for_window [class="xdman-Main"] floating enable
for_window [class="java-lang-Thread"] floating enable
for_window [class="VirtualBox Manager"] floating enable
for_window [class="Qq"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [class="Qalculate-gtk"] floating enable
for_window [class="Nitrogen"] floating enable
for_window [class="Steam"] floating enable
for_window [class="words-picker"] floating enable
for_window [class="copyq"] floating enable, resize set 560 px 640 px, move position center
for_window [class="(?i)pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [title="^(Open File|Open Files|Save As|Save File|File Upload|打开文件|另存为)"] floating enable

# Dialogs and pop-ups float instead of breaking the tiling layout
for_window [window_role="pop-up|dialog|task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
# Picture-in-picture videos float and stay on every workspace
for_window [title="Picture-in-Picture|画中画"] floating enable, sticky enable
# Lyrics window (bin/lyrics toggle): floats on every workspace; size/position are restored by the script
for_window [instance="lyrics"] floating enable, sticky enable, border none, resize set 1000 px 420 px, move position center
# Drop-down terminal (bin/dropdown): kept in the scratchpad; the script sizes and places it under the bar
for_window [instance="dropdown"] floating enable, border pixel 2, move scratchpad
# Audio visualizer (bin/cava-toggle): borderless, on every workspace, never takes focus
for_window [instance="cava"] floating enable, sticky enable, border none
no_focus [instance="cava"]
# Noi lives in the scratchpad (its "Quit Noi now?" dialog has another class, so it stays out)
for_window [class="Noi" window_role="browser-window"] floating enable, resize set 60 ppt 80 ppt, move position center, move scratchpad

# Clipboard history (copyq)
bindsym $mod+Shift+v exec --no-startup-id copyq toggle
# Emoji / symbol picker: pick one and it is copied to the clipboard
bindsym $mod1+period exec --no-startup-id rofimoji --action copy --skin-tone neutral
# Notifications: bring back the last one / close all
bindsym $mod1+n exec --no-startup-id dunstctl history-pop
bindsym $mod1+Shift+n exec --no-startup-id dunstctl close-all
# Calculator: results update as you type, Enter copies the result
bindsym $mod1+equal exec --no-startup-id rofi -show calc -modi calc -no-show-match -no-sort -calc-command "echo -n '{result}' | xclip -selection clipboard"

# Show all key bindings (searchable)
bindsym $mod+slash exec --no-startup-id $HOME/.config/i3/bin/keyhelp

# Scratchpad: hide a window, then summon/hide it with one key
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Floating window follows you to every workspace
bindsym $mod+Shift+p sticky toggle

# Search open windows and jump to one
bindsym $mod+o exec --no-startup-id rofi -show window
# Jump to the most recent window requesting attention
bindsym $mod+u [urgent=latest] focus

# Mark a window with a letter, then jump to it from anywhere
bindsym $mod+m exec --no-startup-id i3-input -F 'mark --toggle %s' -l 1 -P 'Mark: '
bindsym $mod+apostrophe exec --no-startup-id i3-input -F '[con_mark="%s"] focus' -l 1 -P 'Go to mark: '
# Swap the focused window with a marked window (enter its one-letter mark)
bindsym $mod+Shift+apostrophe exec --no-startup-id i3-input -F 'swap container with mark %s' -l 1 -P 'Swap with mark: '

# Re-detect displays and rebuild their bars after plugging/unplugging a monitor
bindsym $mod1+p exec --no-startup-id $HOME/.config/i3/bin/display
# Focus another monitor / move the entire workspace to it
bindsym $mod1+Left focus output left
bindsym $mod1+Right focus output right
bindsym $mod1+Shift+Left move workspace to output left
bindsym $mod1+Shift+Right move workspace to output right
# Meeting/focus mode: pause notifications and hide visual extras; restore on exit
bindsym $mod1+f exec --no-startup-id $HOME/.config/i3/bin/focus-mode

# Media keys: any MPRIS player via playerctl, falling back to mpd
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause || mpc toggle
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause || mpc toggle
bindsym XF86AudioNext exec --no-startup-id playerctl next || mpc next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous || mpc prev
bindsym XF86AudioStop exec --no-startup-id playerctl stop || mpc stop

# start a terminal
bindsym $mod+Return exec --no-startup-id alacritty 
#bindsym $mod+shift+Return exec --no-startup-id kitty -e fish


# AppImages: bin/appimage starts the newest <prefix>*.AppImage in /mnt/data/Tools (or the host's APPIMAGE_DIR), so updates need no edits here
bindsym $mod+control+o exec --no-startup-id obsidian
bindsym $mod+control+r exec --no-startup-id obs
bindsym $mod+control+c exec --no-startup-id code
bindsym $mod+control+b exec --no-startup-id $HOME/.config/i3/bin/appimage bilibili-
bindsym $mod+control+t exec --no-startup-id $HOME/.config/i3/bin/appimage teams-for-linux-
bindsym $mod+control+l exec --no-startup-id $HOME/.config/i3/bin/appimage LM-Studio-
# Toggle Noi scratchpad (starts Noi if needed)
bindsym $mod+control+n exec --no-startup-id $HOME/.config/i3/bin/noi-toggle
# ChatGPT in its own window
bindsym $mod+control+g exec --no-startup-id chromium --app=https://chatgpt.com
# Toggle WeChat scratchpad (starts WeChat if needed)
bindsym $mod+control+w exec --no-startup-id $HOME/.config/i3/bin/wechat-toggle
# Restart WeChat (kills the old instance first), back into the scratchpad
bindsym $mod+control+Shift+w exec --no-startup-id "pkill -9 -i wechat; sleep 1; $HOME/.config/i3/bin/wechat-toggle"
# Double Commander: the installed package if there is one, otherwise the AppImage
bindsym $mod+control+d exec --no-startup-id "command -v doublecmd >/dev/null && exec doublecmd || exec $HOME/.config/i3/bin/appimage doublecmd-gtk"

# Control mpd: play/pause, previous / next song (like Alt+[ ] for workspaces)
bindsym $mod1+m exec mpc toggle
bindsym $mod1+bracketleft exec mpc prev
bindsym $mod1+bracketright exec mpc next
# Toggle the scrolling lyrics window for the mpd song
bindsym $mod1+l exec --no-startup-id $HOME/.config/i3/bin/lyrics toggle

# Effects (Super+key)
# Drop-down terminal: slides down from the top, press again to hide
bindsym $mod1+Return exec --no-startup-id $HOME/.config/i3/bin/dropdown
# Audio visualizer along the bottom of the screen
bindsym $mod1+v exec --no-startup-id $HOME/.config/i3/bin/cava-toggle
# Desktop widget on/off
bindsym $mod1+d exec --no-startup-id $HOME/.config/i3/bin/widgets
# Video wallpaper on/off (random video from ~/Videos/wallpapers)
bindsym $mod1+w exec --no-startup-id $HOME/.config/i3/bin/livewall
# Colour theme: cycle Nord -> classic black -> pywal (from the current wallpaper)
bindsym $mod1+t exec --no-startup-id $HOME/.config/i3/bin/theme toggle

# Polybar reload
bindsym $mod+p exec "$HOME/.config/i3/bin/i3bar"

# Fold the informational modules (weather, backlight, battery, volume) away when the
# bar is crowded; also clickable as the arrow left of that group.
bindsym $mod+Shift+b exec --no-startup-id "$HOME/.config/i3/bin/bar-collapse"

# start specific application
bindsym $mod+c exec --no-startup-id firefox
bindsym $mod+z exec --no-startup-id zathura
#bindsym $mod+n exec --no-startup-id netbeans
bindsym $mod+t exec --no-startup-id thunderbird 
bindsym $mod+shift+n exec --no-startup-id thunar
bindsym --release $mod1+Escape exec --no-startup-id loginctl lock-session
# Power menu (lock, sleep, log out, reboot, shut down)
bindsym $mod1+Shift+Escape exec --no-startup-id $HOME/.config/rofi/bin/powermenu

# Screenshots (flameshot names files by date and time, so they never overwrite each other).
# On Super+S rather than Print: the keyboard has no Print key.
# Select a region
bindsym $mod1+s exec --no-startup-id flameshot gui
# Full screenshot saved to ~/Pictures
bindsym $mod1+Shift+s exec --no-startup-id flameshot full -p $HOME/Pictures
# Full screenshot after 5 seconds
bindsym $mod1+control+s exec --no-startup-id flameshot full -d 5000 -p $HOME/Pictures
# Full screenshot to the clipboard
bindsym $mod1+$mod+s exec --no-startup-id flameshot full -c
# Screen recording: start / stop, saved to ~/Videos (a red dot shows on the bar while recording)
bindsym $mod1+Shift+r exec --no-startup-id $HOME/.config/i3/bin/record

# enable and disable touchpad
# reference: https://wiki.archlinux.org/index.php/Libinput#Disable_touchpad
#bindsym $mod+control+e exec --no-startup-id "xinput enable 'DELL0828:00 06CB:7E7E Touchpad'"
#bindsym $mod+control+d exec --no-startup-id "xinput disable 'DELL0828:00 06CB:7E7E Touchpad'"

# Night light: switch between day and night colours now (bin/nightlight; Super+R a returns to the schedule)
bindsym $mod1+control+n exec --no-startup-id $HOME/.config/i3/bin/nightlight

# redshift modes
bindsym $mod1+r mode "$mode_redshift"
set $mode_redshift Set colour temperature: (a)uto, (r)eset, (2)500K, (3)000K, (4)000K, (5)000K
# Also drops bin/nightlight's day/night override, so its toggle reads the new state
set $kill_redshift pkill -9 redshift; rm -f $XDG_RUNTIME_DIR/dotfiles-nightlight;
mode "$mode_redshift" {
    bindsym a exec --no-startup-id $HOME/.config/i3/bin/nightlight auto, mode "default"
    bindsym r exec --no-startup-id "$kill_redshift redshift -x", mode "default"
    bindsym 2 exec --no-startup-id "$kill_redshift redshift -P -O 2500", mode "default"
    bindsym 3 exec --no-startup-id "$kill_redshift redshift -P -O 3000", mode "default"
    bindsym 4 exec --no-startup-id "$kill_redshift redshift -P -O 4000", mode "default"
    bindsym 5 exec --no-startup-id "$kill_redshift redshift -P -O 5000", mode "default"
 
    # exit mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}


# kill focused window
bindsym $mod+q kill
bindsym --release $mod1+q exec --no-startup-id xkill

# start dmenu (a program launcher)
#bindsym $mod+d exec rofi -show drun
bindsym $mod+d exec --no-startup-id rofi -show combi
bindsym $mod+Tab exec rofi -show run
# There also is the (new) i3-dmenu-desktop which only displays applications
# shipping a .desktop file. It is a wrapper around dmenu, so you need that
# installed.
# bindsym $mod+d exec --no-startup-id i3-dmenu-desktop

focus_wrapping no
# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+semicolon split h
# split in vertical orientation
bindsym $mod+v split v
# split orientation toggle
bindsym $mod+shift+q split toggle

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Toggle gaps on the current workspace
bindsym $mod+g gaps inner current toggle 10
# Toggle autotiling on/off
bindsym $mod+Shift+t exec --no-startup-id "pkill -x autotiling || autotiling"


# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+x focus child

# Pressing the current workspace's number again goes back to the previous one
workspace_auto_back_and_forth yes
# Jump back to the previous workspace
bindsym $mod+grave workspace back_and_forth

# Move to prev and next workspace
bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# move focused container to workspace and follow it there
bindsym $mod+control+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+control+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+control+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+control+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+control+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+control+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+control+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+control+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+control+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+control+0 move container to workspace number $ws10; workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+Escape exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ---------------------------------------------------------------------------
# Per-machine overrides. Stowed from hosts/<hostname>/ by bin/dotfiles-bootstrap.
# A host may only bind keys that are free above: binding one of them again is a
# duplicate-keybinding error in i3, not an override (see hosts/README.md).
# A missing file is silently skipped by i3 (verified on 4.25), so this is safe
# on a machine that has no host package yet.
# ---------------------------------------------------------------------------
include ~/.config/dotfiles-host/i3.conf
