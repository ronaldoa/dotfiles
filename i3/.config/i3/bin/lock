#!/usr/bin/env bash
# Lock the screen. Used by xss-lock in the i3 config; runs i3lock in the foreground (-n) as xss-lock expects.
# With i3lock-color the background is a blurred shot of the screen as it is right now, with a clock
# and a Nord-coloured ring that reacts to typing.
# Plain i3lock can't blur or scale: it shows a random PNG from ~/Pictures/lockscreen, else the
# nitrogen wallpaper if that is a PNG (only right at the screen resolution), else a Nord background.

dir="$HOME/Pictures/lockscreen"
shopt -s nullglob
images=("$dir"/*.png)

color=0
# i3lock-color's version looks like 2.13.c.5
i3lock --version 2>&1 | grep -q '\.c\.' && color=1

if ! ((color)); then
    if ((${#images[@]})); then
        image=${images[RANDOM % ${#images[@]}]}
    else
        # Otherwise the desktop wallpaper saved by nitrogen (plain i3lock only reads PNG)
        image=$(sed -n 's/^file=//p' ~/.config/nitrogen/bg-saved.cfg 2>/dev/null | head -1)
        [[ $image == *.png ]] || image=
    fi
    [ -f "$image" ] && bg=(-i "$image")
    exec i3lock -n -c 2E3440 "${bg[@]}"
fi

bg=(--blur 10)

# Colours are RRGGBBAA
exec i3lock -n -c 2E3440 "${bg[@]}" \
    --clock --indicator --radius 110 --ring-width 8 \
    --time-str '%H:%M' --date-str '%Y-%m-%d %A' \
    --time-font 'Hack Nerd Font' --date-font 'Hack Nerd Font' \
    --layout-font 'Hack Nerd Font' --verif-font 'Hack Nerd Font' --wrong-font 'Hack Nerd Font' \
    --time-size 40 --date-size 16 \
    --time-color ECEFF4ff --date-color D8DEE9ff \
    --inside-color 2E3440aa --ring-color 5E81ACff --line-uses-inside \
    --keyhl-color 88C0D0ff --bshl-color D08770ff --separator-color 00000000 \
    --insidever-color 2E3440aa --ringver-color EBCB8Bff --verif-color EBCB8Bff \
    --insidewrong-color 2E3440aa --ringwrong-color BF616Aff --wrong-color BF616Aff \
    --verif-text '验证中…' --wrong-text '密码错误' --noinput-text '' \
    --pass-media-keys --pass-volume-keys
