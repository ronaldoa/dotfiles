#!/usr/bin/python3
"""Alt+drag the conky desktop widget (all cards move together); Alt+right-click puts it back.

    conky-drag        started by bin/widgets; exits when the widget window goes away

The widget is an override-redirect window i3 doesn't manage, so i3's floating_modifier drag
can't reach it: this grabs the same Alt+button on that window instead. The position is kept
per machine in ~/.cache/conky-widgets/position and restored whenever the widget starts.
"""
import os
from pathlib import Path
import subprocess
import sys
import time

from Xlib import X, display

STATE = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'conky-widgets/position'
MOD = X.Mod1Mask  # i3's $mod, which is also its floating_modifier


def find(root):
    for _ in range(50):
        for win in root.query_tree().children:
            try:
                cls = win.get_wm_class()
            except Exception:
                continue
            if cls and cls[1] == 'conky':
                return win
        time.sleep(0.1)
    return None


def monitors(d, root):
    try:
        return [(m.x, m.y, m.width_in_pixels, m.height_in_pixels)
                for m in d.xrandr_get_monitors(root, is_active=True).monitors]
    except Exception:
        g = root.get_geometry()
        return [(0, 0, g.width, g.height)]


def head_at(heads, x, y):
    return next((m for m in heads if m[0] <= x < m[0] + m[2] and m[1] <= y < m[1] + m[3]), None)


def clamp(head, x, y, w, h):
    """Keep the whole widget on one monitor."""
    mx, my, mw, mh = head
    return max(mx, min(x, mx + mw - w)), max(my, min(y, my + mh - h))


def main():
    d = display.Display()
    root = d.screen().root
    win = find(root)
    if win is None:
        sys.exit(1)
    win.change_attributes(event_mask=X.StructureNotifyMask)
    g = win.get_geometry()
    try:
        x, y = map(int, STATE.read_text().split())
    except (OSError, ValueError):
        pass
    else:
        # Monitors change between sessions: a saved spot no longer on screen falls back to conky.conf.
        head = head_at(monitors(d, root), x + g.width // 2, y + g.height // 2)
        if head:
            x, y = clamp(head, x, y, g.width, g.height)
            win.configure(x=x, y=y)
    for extra in (0, X.Mod2Mask, X.LockMask, X.Mod2Mask | X.LockMask):  # With NumLock / CapsLock on too.
        for button in (1, 3):
            win.grab_button(button, MOD | extra, False,
                            X.ButtonPressMask | X.ButtonReleaseMask | X.PointerMotionMask,
                            X.GrabModeAsync, X.GrabModeAsync, X.NONE, X.NONE)
    d.sync()

    drag = None
    while True:
        e = d.next_event()
        if e.type == X.DestroyNotify:
            return
        if e.type == X.ButtonPress and e.detail == 1:
            g = win.get_geometry()
            drag = (e.root_x - g.x, e.root_y - g.y, g.width, g.height, monitors(d, root))
        elif e.type == X.MotionNotify and drag:
            dx, dy, w, h, heads = drag
            head = head_at(heads, e.root_x, e.root_y) or heads[0]
            x, y = clamp(head, e.root_x - dx, e.root_y - dy, w, h)
            win.configure(x=x, y=y)
            d.flush()
        elif e.type == X.ButtonRelease and e.detail == 1 and drag:
            drag = None
            g = win.get_geometry()
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(f'{g.x} {g.y}\n')
        elif e.type == X.ButtonPress and e.detail == 3:
            STATE.unlink(missing_ok=True)
            widgets = Path(__file__).resolve().parent / 'widgets'
            # Restarting conky re-applies conky.conf's position (and ends this helper with the old window).
            subprocess.Popen(['sh', '-c', '"$0" stop && "$0" start', str(widgets)], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


if __name__ == '__main__':
    main()
