#!/usr/bin/env bash
# Colour theme for i3 borders, polybar, rofi, alacritty, tmux and the p10k prompt (Super+T cycles).
#   theme nord     the default Nord palette
#   theme classic  the old look: near-black terminal with Tango colours, bright tmux bar
#                  (i3, polybar and rofi stay Nord, as they always were)
#   theme wal      palette generated by pywal from the current nitrogen wallpaper
#   theme toggle   cycle nord -> classic -> wal -> nord (wal is skipped without pywal)
#   theme restore  re-apply the saved choice (run at login)
# i3 and polybar read theme.* from xrdb; alacritty, rofi and tmux import files in ~/.cache/theme;
# p10k reads ~/.cache/theme/mode, so only shells started afterwards pick up a new prompt colour.

state="$HOME/.cache/theme"
mkdir -p "$state"
saved=$(cat "$state/mode" 2>/dev/null || echo nord)

case $1 in
    nord | classic | wal) mode=$1 ;;
    toggle)
        case $saved in
            nord) mode=classic ;;
            classic) command -v wal >/dev/null && mode=wal || mode=nord ;;
            *) mode=nord ;;
        esac ;;
    restore) mode=$saved ;;
    *) echo "usage: theme nord|classic|wal|toggle|restore" >&2; exit 1 ;;
esac

apply_nord() {
    xrdb -merge ~/.config/i3/themes/nord.Xresources
    : > "$state/alacritty.toml"
    : > "$state/rofi.rasi"
    : > "$state/tmux.conf"
}

apply_classic() {
    xrdb -merge ~/.config/i3/themes/nord.Xresources
    : > "$state/rofi.rasi"
    cat > "$state/alacritty.toml" <<'EOF'
[colors.primary]
background = "#181818"
foreground = "#eeeeec"

[colors.normal]
black = "#2e3436"
red = "#cc0000"
green = "#73d216"
yellow = "#edd400"
blue = "#3465a4"
magenta = "#75507b"
cyan = "#06989a"
white = "#d3d7cf"

[colors.bright]
black = "#2e3436"
red = "#ef2929"
green = "#8ae234"
yellow = "#fce94f"
blue = "#729fcf"
magenta = "#ad7fa8"
cyan = "#34e2e2"
white = "#eeeeec"
EOF
    # oh-my-tmux's original palette. Lowercase hex only: #D... is a tmux format alias.
    # tmux expands the style variables while it parses ~/.tmux.conf.local but only runs this
    # file's source-file afterwards, so the styles built from the colours are repeated below
    # (copied from the local file) to expand again with the new values.
    {
        cat <<'EOF'
tmux_conf_theme_colour_1="#080808"
tmux_conf_theme_colour_2="#303030"
tmux_conf_theme_colour_3="#8a8a8a"
tmux_conf_theme_colour_4="#00afff"
tmux_conf_theme_colour_5="#ffff00"
tmux_conf_theme_colour_6="#080808"
tmux_conf_theme_colour_7="#e4e4e4"
tmux_conf_theme_colour_8="#080808"
tmux_conf_theme_colour_9="#ffff00"
tmux_conf_theme_colour_10="#ff00af"
tmux_conf_theme_colour_11="#5fff00"
tmux_conf_theme_colour_12="#8a8a8a"
tmux_conf_theme_colour_13="#e4e4e4"
tmux_conf_theme_colour_14="#080808"
tmux_conf_theme_colour_15="#080808"
tmux_conf_theme_colour_16="#d70000"
tmux_conf_theme_colour_17="#e4e4e4"
tmux_conf_theme_colour_18="#d70000"
EOF
        grep '^tmux_conf_theme_[a-z0-9_]*=.*\$tmux_conf_theme_colour_' ~/.tmux.conf.local
    } > "$state/tmux.conf"
}

apply_wal() {
    local wallpaper json=~/.cache/wal/colors.json
    wallpaper=$(sed -n 's/^file=//p' ~/.config/nitrogen/bg-saved.cfg 2>/dev/null | head -1)
    if ! command -v wal >/dev/null || [ ! -f "$wallpaper" ]; then
        notify-send "主题" "需要安装 pywal,并先用 nitrogen 设置壁纸"
        return 1
    fi
    # -n: leave the wallpaper alone, -s/-t: don't recolour open terminals/ttys, -e: don't reload gtk
    wal -q -n -s -t -e -i "$wallpaper" || return 1

    c() { jq -r ".colors.color$1" "$json"; }
    xrdb -merge <<EOF
theme.background: $(jq -r .special.background "$json")
theme.foreground: $(jq -r .special.foreground "$json")
theme.black:      $(c 8)
theme.red:        $(c 1)
theme.green:      $(c 2)
theme.yellow:     $(c 3)
theme.blue:       $(c 4)
theme.magenta:    $(c 5)
theme.cyan:       $(c 6)
theme.white:      $(c 7)
theme.altblack:   $(c 8)
theme.altcyan:    $(c 14)
theme.altwhite:   $(c 15)
theme.accent:     $(c 4)
EOF

    jq -r '
        def norm: {black: .color0, red: .color1, green: .color2, yellow: .color3,
                   blue: .color4, magenta: .color5, cyan: .color6, white: .color7};
        def bright: {black: .color8, red: .color9, green: .color10, yellow: .color11,
                     blue: .color12, magenta: .color13, cyan: .color14, white: .color15};
        def section(name; obj): "[\(name)]\n" + (obj | to_entries | map("\(.key) = \"\(.value)\"") | join("\n")) + "\n";
        section("colors.primary"; {background: .special.background, foreground: .special.foreground}),
        section("colors.normal"; .colors | norm),
        section("colors.bright"; .colors | bright)
    ' "$json" > "$state/alacritty.toml"

    # Same variables as ~/.config/rofi/themes/colors.rasi, so only the colours change
    jq -r '"* {",
        "    bg:     \(.special.background);",
        "    bg-alt: \(.colors.color0);",
        "    bg-sel: \(.colors.color8);",
        "    fg:     \(.special.foreground);",
        "    fg-dim: \(.special.foreground)80;",
        "    accent: \(.colors.color4);",
        "    urgent: \(.colors.color1);",
        "}"' "$json" > "$state/rofi.rasi"
    : > "$state/tmux.conf"
}

if [ "$mode" = wal ] && ! apply_wal; then
    mode=nord
fi
[ "$mode" = classic ] && apply_classic
[ "$mode" = nord ] && apply_nord
echo "$mode" > "$state/mode"
# Running alacritty windows only watch their main config file, not the imported colours
touch ~/.config/alacritty/alacritty.toml
# Re-source tmux so its bar picks up ~/.cache/theme/tmux.conf (fails quietly with no server)
tmux source-file ~/.tmux.conf 2>/dev/null

# At login everything starts with the Nord fallback, so only a pywal theme needs a reload
if [ "$1" != restore ] || [ "$mode" = wal ]; then
    i3-msg -q reload
    ~/.config/i3/bin/i3bar >/dev/null 2>&1
fi
[ "$1" = restore ] || notify-send "主题" "已切换到 $mode"
