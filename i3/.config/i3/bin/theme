#!/usr/bin/env bash
# Colour theme for i3 borders, polybar, rofi and alacritty (Super+T toggles).
#   theme nord     the default Nord palette
#   theme wal      palette generated by pywal from the current nitrogen wallpaper
#   theme toggle   switch between the two
#   theme restore  re-apply the saved choice (run at login)
# i3 and polybar read theme.* from xrdb; alacritty and rofi import files in ~/.cache/theme.

state="$HOME/.cache/theme"
mkdir -p "$state"
saved=$(cat "$state/mode" 2>/dev/null || echo nord)

case $1 in
    nord | wal) mode=$1 ;;
    toggle) [ "$saved" = nord ] && mode=wal || mode=nord ;;
    restore) mode=$saved ;;
    *) echo "usage: theme nord|wal|toggle|restore" >&2; exit 1 ;;
esac

apply_nord() {
    xrdb -merge ~/.config/i3/themes/nord.Xresources
    : > "$state/alacritty.toml"
    : > "$state/rofi.rasi"
}

apply_wal() {
    local wallpaper json=~/.cache/wal/colors.json
    wallpaper=$(sed -n 's/^file=//p' ~/.config/nitrogen/bg-saved.cfg 2>/dev/null | head -1)
    if ! command -v wal >/dev/null || [ ! -f "$wallpaper" ]; then
        notify-send "主题" "需要安装 pywal,并先用 nitrogen 设置壁纸"
        return 1
    fi
    # -n: leave the wallpaper alone, -s/-t: don't recolour open terminals/ttys, -e: don't reload gtk
    wal -q -n -s -t -e -i "$wallpaper" || return 1

    c() { jq -r ".colors.color$1" "$json"; }
    xrdb -merge <<EOF
theme.background: $(jq -r .special.background "$json")
theme.foreground: $(jq -r .special.foreground "$json")
theme.black:      $(c 8)
theme.red:        $(c 1)
theme.green:      $(c 2)
theme.yellow:     $(c 3)
theme.blue:       $(c 4)
theme.magenta:    $(c 5)
theme.cyan:       $(c 6)
theme.white:      $(c 7)
theme.altblack:   $(c 8)
theme.altcyan:    $(c 14)
theme.altwhite:   $(c 15)
theme.accent:     $(c 4)
EOF

    jq -r '
        def norm: {black: .color0, red: .color1, green: .color2, yellow: .color3,
                   blue: .color4, magenta: .color5, cyan: .color6, white: .color7};
        def bright: {black: .color8, red: .color9, green: .color10, yellow: .color11,
                     blue: .color12, magenta: .color13, cyan: .color14, white: .color15};
        def section(name; obj): "[\(name)]\n" + (obj | to_entries | map("\(.key) = \"\(.value)\"") | join("\n")) + "\n";
        section("colors.primary"; {background: .special.background, foreground: .special.foreground}),
        section("colors.normal"; .colors | norm),
        section("colors.bright"; .colors | bright)
    ' "$json" > "$state/alacritty.toml"

    # Same variables as ~/.config/rofi/themes/colors.rasi, so only the colours change
    jq -r '"* {",
        "    bg:     \(.special.background);",
        "    bg-alt: \(.colors.color0);",
        "    bg-sel: \(.colors.color8);",
        "    fg:     \(.special.foreground);",
        "    fg-dim: \(.special.foreground)80;",
        "    accent: \(.colors.color4);",
        "    urgent: \(.colors.color1);",
        "}"' "$json" > "$state/rofi.rasi"
}

if [ "$mode" = wal ] && ! apply_wal; then
    mode=nord
fi
[ "$mode" = nord ] && apply_nord
echo "$mode" > "$state/mode"
# Running alacritty windows only watch their main config file, not the imported colours
touch ~/.config/alacritty/alacritty.toml

# At login everything starts with the Nord fallback, so only a pywal theme needs a reload
if [ "$1" != restore ] || [ "$mode" = wal ]; then
    i3-msg -q reload
    ~/.config/i3/bin/i3bar >/dev/null 2>&1
fi
[ "$1" = restore ] || notify-send "主题" "已切换到 $mode"
