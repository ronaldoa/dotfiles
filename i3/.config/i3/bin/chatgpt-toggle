#!/usr/bin/env bash
# Toggle the ChatGPT scratchpad window; launch it if it isn't running yet.
running() { i3-msg -t get_tree | grep -q '"instance":"chatgpt.com"'; }

if ! running; then
    chromium --app=https://chatgpt.com >/dev/null 2>&1 &
    # for_window sends the new window straight to the scratchpad; wait for it, then show it
    for _ in $(seq 50); do running && break; sleep 0.1; done
    sleep 0.2
fi
i3-msg -q '[instance="chatgpt.com"] scratchpad show'
