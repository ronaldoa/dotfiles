#!/usr/bin/env bash
# One bar per distinct screen area. Media and the tray appear on the primary screen only.
set -euo pipefail
runtime="${XDG_RUNTIME_DIR:-/tmp}"
exec 9>"$runtime/dotfiles-i3bar-$UID.lock"
flock -x 9

# Left-hand modules differ per machine, so they come from the hosts/ layer rather than
# being probed here: the ThinkPad's iGPU exposes no hwmon sensor, so `hardware gpu-temp`
# is empty there and Polybar drops the module entirely -- taking its click target, and
# with it the only way to open the GPU card, along with it. That host shows the GPU name
# instead. bar.env is optional; without it the default below applies.
BAR_LEFT='i3 cpu_temp gpu_temp memory'
host_bar="$HOME/.config/dotfiles-host/bar.env"
if [ -r "$host_bar" ]; then
    . "$host_bar"
fi

# Query before stopping the old bars, so a failed display query leaves them intact.
mapfile -t screens < <(polybar --list-all-monitors)
((${#screens[@]})) || exit 1
primary=${screens[0]%%:*}
for screen in "${screens[@]}"; do
    [[ "$screen" = *'(primary)'* ]] && primary=${screen%%:*}
done

pkill -u "$UID" -x polybar || true
for _ in {1..50}; do
    pgrep -u "$UID" -x polybar >/dev/null || break
    sleep 0.1
done
if pgrep -u "$UID" -x polybar >/dev/null; then
    echo 'polybar did not stop; leaving it alone' >&2
    exit 1
fi

log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/polybar"
mkdir -p "$log_dir"
declare -A seen=()
# Prefer the primary output if two outputs mirror the same screen area.
ordered=()
for screen in "${screens[@]}"; do
    [ "${screen%%:*}" = "$primary" ] && ordered=("$screen" "${ordered[@]}") || ordered+=("$screen")
done
for screen in "${ordered[@]}"; do
    monitor=${screen%%:*}
    geometry=${screen#*: }; geometry=${geometry%% *}
    [ -n "${seen[$geometry]:-}" ] && continue
    seen[$geometry]=1
    center='' right='record collapse weather backlight battery volume date focus powermenu'
    if [ "$monitor" = "$primary" ]; then
        center='lyrics cava mpd'
        right='record collapse weather backlight battery volume date systray focus powermenu'
    fi
    [ -f "$runtime/dotfiles-i3-focus-$UID.json" ] && center=''
    # Each group is a rounded island (pill caps are in the polybar config); no centre group, no island
    [ -n "$center" ] && center="pill-l2 $center pill-r2"
    # The centre island is about 45% of the screen: the song/lyric slot (8.7px per cell in Hack 12)
    # gets what is left after ~300px of caps, icons and controls, and the 14-bar spectrum
    # (16 cells, kept as blanks while silent so the island doesn't jump). Measured on a 2560px screen.
    # A longer lyric line widens the island up to 52%, which still leaves a gap on both sides.
    width=${geometry%%x*}
    now_cols=$(( (width * 45 / 100 - 300) * 10 / 87 - 16 ))
    now_max=$(( (width * 52 / 100 - 300) * 10 / 87 - 16 ))
    MONITOR="$monitor" NOW_COLS="$now_cols" NOW_MAX="$now_max" BAR_LEFT="pill-l1 $BAR_LEFT pill-r1" BAR_CENTER="$center" BAR_RIGHT="pill-l3 $right pill-r3" \
        polybar main -c "$HOME/.config/i3/polybar/config" \
        >"$log_dir/${monitor//\//_}.log" 2>&1 9>&- &
done

# Both the hidden modules and the arrow's hook live inside the Polybar process, so
# fresh bars come up expanded with a blank arrow (and no recording dot). Re-apply the saved state either
# way; the bars need a moment before they accept IPC.
(sleep 1; "$HOME/.config/i3/bin/bar-collapse" restore >/dev/null 2>&1; "$HOME/.config/i3/bin/record" restore) &
