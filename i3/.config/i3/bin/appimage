#!/usr/bin/env bash
# Launch the newest AppImage in the AppImage directory whose name starts with the given prefix,
# so key bindings keep working after downloading a new version:  appimage LM-Studio-
# Extra arguments are passed on to the app.
# The directory defaults to /mnt/data/Tools; a host sets APPIMAGE_DIR in
# ~/.config/dotfiles-host/appimage.env (optional, sourced if present) to use another one.
host_env="$HOME/.config/dotfiles-host/appimage.env"
[ -r "$host_env" ] && . "$host_env"
dir=${APPIMAGE_DIR:-/mnt/data/Tools}
prefix=$1
shift

# Case-insensitive, since downloads are not consistent (Cursor-… on one machine, cursor-… on another)
shopt -s nocaseglob nullglob
app=$(printf '%s\n' "$dir/$prefix"*.[Aa]pp[Ii]mage | sort -V | tail -n 1)
if [ ! -f "$app" ]; then
    notify-send "AppImage" "在 $dir 里找不到 $prefix*.AppImage"
    exit 1
fi
exec "$app" "$@"
