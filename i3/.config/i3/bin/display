#!/usr/bin/python3
"""Re-detect monitors, apply preferred modes at their highest refresh rate, rebuild bars.

display --dry prints the command; --no-bar applies modes only (used at login).
Connected outputs without a preferred mode use the active mode, then the first mode.
"""
from pathlib import Path
import re
import shlex
import subprocess
import sys


def display_args(query):
    outputs, current = [], None
    for line in query.splitlines():
        match = re.match(r'^(\S+) (connected|disconnected)\b(.*)', line)
        if match:
            current = {'name': match[1], 'connected': match[2] == 'connected',
                       'primary': bool(re.search(r'\bprimary\b', match[3])), 'modes': []}
            outputs.append(current)
        elif current and current['connected']:
            mode = re.match(r'^\s+(\S+)\s+([\d.].*)$', line)
            if not mode:
                continue
            rates = re.findall(r'(\d+(?:\.\d+)?)([*+]*)', mode[2])
            if rates:
                current['modes'].append((mode[1], max(float(r) for r, _ in rates),
                                         '+' in mode[2], '*' in mode[2]))
    active = [o for o in outputs if o['connected'] and o['modes']]
    if not active:
        return []
    primary = next((o['name'] for o in active if o['primary']), None)
    if primary is None:
        primary = next((o['name'] for o in active if o['name'].startswith(('eDP', 'LVDS', 'DSI'))), active[0]['name'])
    args, previous = [], None
    for output in outputs:
        if not output['connected']:
            args += ['--output', output['name'], '--off']
            continue
        if not output['modes']:
            continue
        mode = max(output['modes'], key=lambda m: (m[2], m[3]))
        args += ['--output', output['name'], '--mode', mode[0], '--rate', str(mode[1])]
        if output['name'] == primary:
            args.append('--primary')
        if previous:
            args += ['--right-of', previous]
        else:
            args += ['--pos', '0x0']
        previous = output['name']
    return args


def main():
    if any(arg not in ('--dry', '--no-bar') for arg in sys.argv[1:]):
        sys.exit(__doc__)
    query = subprocess.check_output(['xrandr', '--query'], text=True)
    args = display_args(query)
    if not args:
        sys.exit('No usable connected display found; keeping the current layout.')
    if '--dry' in sys.argv:
        print(shlex.join(['xrandr', *args]))
        return
    subprocess.run(['xrandr', *args], check=True)
    if '--no-bar' not in sys.argv:
        subprocess.run([str(Path(__file__).resolve().with_name('i3bar'))], check=True)


if __name__ == '__main__':
    main()
