#!/usr/bin/env bash
# Toggle the conky desktop widget (Super+D); `widgets start` only starts it if it isn't running.
# conky is an override-redirect window that starts on top of the stack, so push it below every window.
# Matched by config path: other conky instances (the weather popup) are left alone
conf="$HOME/.config/conky/conky.conf"
if pgrep -f "conky -d -c $conf" >/dev/null; then
    [ "$1" = start ] || pkill -f "conky -d -c $conf"
    exit 0
fi

conky -d -c "$conf" >/dev/null 2>&1
~/.config/i3/bin/xstack conky below
