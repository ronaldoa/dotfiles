#!/usr/bin/env bash
# Video wallpaper (Super+W toggles): plays a random video from ~/Videos/wallpapers on loop, muted,
# behind all windows (xwinwrap + mpv). Turning it off restores the nitrogen wallpaper.
#   livewall          toggle
#   livewall <file>   play this video

dir="$HOME/Videos/wallpapers"

if pkill -x xwinwrap; then
    [ -z "$1" ] && exit 0
fi

if [ -n "$1" ]; then
    video=$1
else
    shopt -s nullglob nocaseglob
    videos=("$dir"/*.{mp4,mkv,webm,mov})
    if ! ((${#videos[@]})); then
        notify-send "动态壁纸" "$dir 里没有视频(mp4/mkv/webm/mov)"
        exit 1
    fi
    video=${videos[RANDOM % ${#videos[@]}]}
fi

# -ni: ignore input, -b: below everything, -ov: override-redirect, -fs: fullscreen
xwinwrap -ni -b -ov -fs -nf -un -s -st -sp -- \
    mpv -wid WID --loop --no-audio --no-osc --no-osd-bar --no-input-default-bindings \
    --panscan=1.0 --hwdec=auto --really-quiet "$video" &
disown
