[module/date]
type = internal/date

interval = 1.0

date = %a, %b %d
time = %H:%M:%S

; Click to toggle a calendar popup
format = %{A1:~/.config/i3/polybar/script/calendar.sh:}<label>%{A}
format-prefix = " "
format-prefix-font = 2
format-prefix-foreground = ${color.RED}

label = %date% %time%

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_





[module/mpd]
type = internal/mpd

host = 127.0.0.1
port = 6600
;;password = mysecretpassword

interval = 2

; Click the song title to pick another song, right-click to rescan the library into the queue (bin/music-pick)
format-online = %{A1:~/.config/i3/bin/music-pick &:}%{A3:~/.config/i3/bin/music-pick --refresh &:}<label-song>%{A}%{A} <icon-prev> <toggle> <icon-next>
format-online-prefix = " "
format-online-prefix-font = 1
format-online-prefix-foreground = ${color.GREEN}

format-playing = ${self.format-online}
format-paused = %{A1:~/.config/i3/bin/music-pick &:}%{A3:~/.config/i3/bin/music-pick --refresh &:}<label-song>%{A}%{A} <toggle>

format-offline = <label-offline>
label-offline = "Offline"

format-stopped = MPD: Stopped
label-stopped = "Stopped"

label-song = "%title% - %artist%"
label-song-maxlen = 60
label-song-ellipsis = true

;label-song-scroll = true
;label-song-scroll-speed = 2        ; 滚动速度，数字越大越慢
;label-song-scroll-delay = 2        ; 停顿开始滚动前的延迟（秒）
;label-song-scroll-padding = 5      ; 滚动末尾填充空格数，避免滚动突兀


icon-play = " "
icon-play-font = 2
icon-play-foreground = ${color.GREEN}
icon-pause = " "
icon-pause-font = 2
icon-pause-foreground = ${color.YELLOW}
icon-stop = " "
icon-stop-foreground = ${color.RED}
icon-prev = 󰼨
icon-prev-font = 2
icon-prev-foreground = ${color.CYAN}
icon-next = 󰼧
icon-next-font = 2
icon-next-foreground = ${color.CYAN}

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

[module/cava]
; Audio spectrum of whatever is playing (hidden when silent); click for the big visualizer window
type = custom/script
exec = ~/.config/i3/polybar/script/cava.sh
tail = true
click-left = ~/.config/i3/bin/cava-toggle &
format-foreground = ${color.BLUE}

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

[module/lyrics]
; Current lyric line of the mpd song (~/.config/i3/bin/lyrics); click for the full lyrics window
type = custom/script
exec = ~/.config/i3/bin/lyrics bar
tail = true
click-left = ~/.config/i3/bin/lyrics toggle &
; Scroll to fix timing for this song: up = lyrics earlier, down = later
scroll-up = ~/.config/i3/bin/lyrics offset +0.5 &
scroll-down = ~/.config/i3/bin/lyrics offset -0.5 &
format-foreground = ${color.CYAN}
label-maxlen = 60

;; _-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

[module/network]
type = custom/script
; Follow the route actually used (Ethernet, Wi-Fi or VPN), including IPv6-only hosts.
exec = ~/.config/i3/bin/hardware network
interval = 3
format-foreground = ${color.CYAN}
click-left = ~/.config/i3/bin/hardware network-info

[module/cpu_temp]
type = custom/script
exec = ~/.config/i3/bin/hardware cpu-temp
interval = 5
format-prefix = " "
format-prefix-font = 2
format-prefix-foreground = ${color.YELLOW}
click-left = ~/.config/i3/bin/hardware cpu-info

[module/gpu_temp]
type = custom/script
exec = ~/.config/i3/bin/hardware gpu-temp
interval = 5
format-prefix = "󰢮 "
format-prefix-font = 1
format-prefix-foreground = ${color.GREEN}
click-left = ~/.config/i3/bin/hardware gpu-info

[module/disks]
type = custom/script
exec = ~/.config/i3/bin/hardware disks
interval = 5
format-foreground = ${color.MAGENTA}
label-maxlen = 28
label-ellipsis = true
click-left = ~/.config/i3/bin/hardware disk-menu

[module/gpu]
type = custom/script
exec = ~/.config/i3/bin/hardware gpu
interval = 5
format-foreground = ${color.GREEN}
click-left = ~/.config/i3/bin/hardware gpu-info

[module/focus]
type = custom/script
exec = ~/.config/i3/bin/focus-mode status
interval = 2
format-foreground = ${color.YELLOW}
click-left = ~/.config/i3/bin/focus-mode

[module/powermenu]
type = custom/text
format = ""
click-left = exec ~/.config/rofi/bin/powermenu


