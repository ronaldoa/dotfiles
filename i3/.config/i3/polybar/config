;; Global WM Settings

[global/wm]
margin-bottom = 0
margin-top = 0

include-file = ~/.config/i3/polybar/colors

[bar/main]
monitor = ${env:MONITOR:}
monitor-strict = true
override-redirect = false

bottom = false
fixed-center = true

width = 100%
height = 34
offset-x = 0
offset-y = 0

background = ${color.BACKGROUND}
foreground = ${color.FOREGROUND}

radius = 10

line-size = 3
line-color = ${color.BLUE}

; A floating, rounded bar: a fully transparent border leaves 5px above it and 10px on the sides, matching
; i3's gaps (smart_gaps is off, so the windows keep theirs too). i3 places dock windows itself, so
; offset-x/y would be ignored; the border is how the gap is made. i3's inner gap already supplies the
; 10px below, so the bottom border stays 0.
border-top-size = 5
border-left-size = 10
border-right-size = 10
border-bottom-size = 0
border-color = #00000000

padding = 2
module-margin-left = 1
module-margin-right = 1

#font-0 = "Hack Nerd Font:size=13;antialias=true;autohint=true"
#font-1 = "Hack Nerd Font:size=12;antialias=true;autohint=true"
#font-2 = "NotoColorEmoji:pixelsize=8:fontformat=truetype:antialias=true:scale=10"
#font-3 = "Weather Icons:style=Regular:size=10;antialias=true"
#font-4 = "Noto Sans CJK:size=12;antialias=true;autohint=true"

#font-0 = "Hack Nerd Font:size=12;3"
#font-1 = "Font Awesome 6 Free:style=Solid:pixelsize=13;2"
#font-2 = NotoColorEmoji:pixelsize=8;1:fontformat=truetype:scale=10:antialias=true;3
#font-3 = Weather Icons:style=Regular:size=10;3
#font-4 = NotoSansCJK:size=12;2


#font-1 = "LiterationMono Nerd Font:size=12;3"
font-0 = Hack Nerd Font:size=12
font-1 = Font Awesome 7 Free:style=Solid:pixelsize=13;2
font-2 = NotoColorEmoji:pixelsize=10:fontformat=truetype:antialias=true
font-3 = Weather Icons:style=Regular:size=10
font-4 = Noto Sans CJK SC:size=12



scroll-up = i3wm-wsnext
scroll-down = i3wm-wsprev

; Compact hardware summary: CPU/GPU temperature and memory usage.
modules-left = ${env:BAR_LEFT:i3 cpu_temp gpu_temp memory}
; Optional full layout: comment the line above and uncomment this one to restore.
; modules-left = i3 cpu cpu_temp memory gpu network disks
; An empty env value uses the fallback too: keep that empty for focus/secondary bars.
modules-center = ${env:BAR_CENTER:}
modules-right = ${env:BAR_RIGHT:weather backlight battery volume date systray focus powermenu}

separator =
spacing = 0

dim-value = 1.0

wm-name = i3
locale = en_US.UTF-8


enable-ipc = true

[settings]

screenchange-reload = false

compositing-background = source
compositing-foreground = over
compositing-overline = over
compositing-underline = over
compositing-border = over

