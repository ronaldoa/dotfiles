#!/usr/bin/env bash
# Install these dotfiles on the current machine.
#
#   bin/dotfiles-bootstrap            # stow generic packages + this host's overrides
#   bin/dotfiles-bootstrap -n         # dry run, show what would change
#   bin/dotfiles-bootstrap -R         # restow (fix up links after adding/removing files)
#   bin/dotfiles-bootstrap -D         # uninstall
#   DOTFILES_HOST=other bin/dotfiles-bootstrap   # pretend to be another host
#
# Everything is stowed into $HOME, resolved at run time -- so this works under
# any username, unlike a .stowrc with a hardcoded --target.
set -euo pipefail

DOTFILES="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# -s: macOS's hostname is "Name.local", the hosts/ directory is just "Name"
HOST="${DOTFILES_HOST:-$(hostname -s)}"
# Untracked editor state can sit inside any package (e.g. mpd/.vscode); never link it into $HOME
STOW_FLAGS=(--target="$HOME" --ignore='\.history' --ignore='\.vscode' --ignore='\.idea')
ACTION="--stow"
DRY=

while getopts ':nRDh' opt; do
  case "$opt" in
    n) STOW_FLAGS+=(--no --verbose); DRY=1 ;;
    R) ACTION="--restow" ;;
    D) ACTION="--delete" ;;
    h) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option -$OPTARG (try -h)" >&2; exit 2 ;;
  esac
done

command -v stow >/dev/null || { echo "GNU stow is not installed" >&2; exit 1; }

# Packages that only make sense on one OS. The Linux ones need X11, PipeWire/PulseAudio
# or i3; cava is among them because its config reads from pulse.
LINUX_ONLY='i3|picom|rofi|dunst|conky|flameshot|gtk|redshift|skippy-xd|wireplumber|cava'
MAC_ONLY='aerospace'
if [ "$(uname)" = Darwin ]; then SKIP="hosts|bin|$LINUX_ONLY"; else SKIP="hosts|bin|$MAC_ONLY"; fi

# Generic packages = every top-level directory that is not infrastructure or for the other OS.
# Hidden directories are skipped too: .git, and untracked editor state such as
# .history (VS Code local history) or .vscode, which would otherwise be stowed into $HOME.
# Plain loop rather than mapfile / find -printf: macOS ships bash 3.2 and BSD find.
PACKAGES=()
for dir in "$DOTFILES"/*/; do
  pkg=$(basename -- "$dir")
  printf '%s\n' "$pkg" | grep -qxE "$SKIP" || PACKAGES+=("$pkg")
done
[ ${#PACKAGES[@]} -gt 0 ] || { echo "no packages found in $DOTFILES" >&2; exit 1; }

echo "dotfiles : $DOTFILES"
echo "target   : $HOME"
echo "host     : $HOST"
echo "packages : ${PACKAGES[*]}"
echo

# A plain file in $HOME with the same content as the package's copy (copied by hand, or
# left by a program that rewrote its config) only blocks the link; replace it with one.
# -ef: the target already is the package file, through a link or a folded directory.
replace_identical() {
  local dir=$1 pkg=$2 src rel target
  REPLACED=0
  [ "$ACTION" = "--delete" ] && return 0
  while IFS= read -r src; do
    rel=${src#"$dir/$pkg/"}
    target="$HOME/$rel"
    if [ -f "$target" ] && [ ! -L "$target" ] && ! [ "$target" -ef "$src" ] && cmp -s "$target" "$src"; then
      if [ -n "$DRY" ]; then
        echo "would replace ~/$rel (same as $pkg/$rel) with a link"
        REPLACED=1
      else
        rm -- "$target"
        echo "replaced ~/$rel (same as $pkg/$rel) with a link"
      fi
    fi
  done < <(find "$dir/$pkg" \( -name .history -o -name .vscode -o -name .idea \) -prune -o -type f -print)
}

# One stow per package, so a conflict (a file in $HOME that differs from the package's)
# only skips that package instead of every one after it; bin/dotfiles-apply runs this
# after each pull, and must still link the rest.
# A dry run deletes nothing, so stow still sees the files it would replace: those packages
# go in PENDING rather than FAILED.
FAILED=() PENDING=()
stow_pkg() {
  replace_identical "$1" "$2"
  if ! stow "${STOW_FLAGS[@]}" --dir="$1" "$ACTION" "$2"; then
    if [ "$REPLACED" = 1 ]; then PENDING+=("$2"); else FAILED+=("$2"); fi
  fi
}

for pkg in "${PACKAGES[@]}"; do stow_pkg "$DOTFILES" "$pkg"; done

# Per-machine overrides. Absent is fine: every include hook in the generic
# configs tolerates a missing file (i3 `include`, alacritty `import`,
# mpd `include_optional`, the `[[ -r ]]` guard in .zshrc).
if [ -d "$DOTFILES/hosts/$HOST" ]; then
  stow_pkg "$DOTFILES/hosts" "$HOST"
  echo "host overrides: applied hosts/$HOST"
else
  echo "host overrides: none for '$HOST' (generic config only)"
  echo "  to add some:  mkdir -p hosts/$HOST/.config/dotfiles-host"
  echo "  available  : $(cd "$DOTFILES/hosts" && ls -d -- */ | tr -d / | tr '\n' ' ')"
fi

if [ ${#FAILED[@]} -gt 0 ]; then
  echo
  echo "NOT linked (stow's message above says which file is in the way): ${FAILED[*]}"
  echo "  that file in \$HOME differs from the package's copy: merge what you want to keep into"
  echo "  the package, delete the file, and run this again"
fi
if [ ${#PENDING[@]} -gt 0 ]; then
  echo
  echo "dry run: stow's conflicts in ${PENDING[*]} are the files it would replace;"
  echo "  if another file is listed there too, it really is in the way"
fi

# Git hooks in .githooks/ run bin/dotfiles-apply after every pull: relink, reload what changed
if [ -z "$DRY" ]; then
  if [ "$ACTION" = "--delete" ]; then
    git -C "$DOTFILES" config --unset core.hooksPath || true
  else
    git -C "$DOTFILES" config core.hooksPath .githooks
    echo "git hooks: after a pull, bin/dotfiles-apply relinks and reloads what changed"
  fi
fi

[ "$ACTION" = "--delete" ] && exit ${#FAILED[@]}

# Report anything the configs and scripts use that is not installed here, as package names
# (command:package, or just the command when the package has the same name). Keep in sync
# with INSTALL.md.
if [ "$(uname)" = Darwin ]; then
  checks=(
    aerospace:nikitabobko/tap/aerospace borders:FelixKratz/formulae/borders
    mpd mpc ncmpcpp fzf chafa nvim:neovim tmux ranger zsh
  )
else
  checks=(
    i3:i3-wm polybar picom rofi rofimoji dunst conky i3lock:i3lock-color xss-lock autotiling
    nitrogen udiskie xsettingsd copyq flameshot xfce4-power-manager nm-applet:network-manager-applet
    blueman-applet:blueman redshift playerctl notify-send:libnotify flock:util-linux
    xrandr:xorg-xrandr xset:xorg-xset xrdb:xorg-xrdb setxkbmap:xorg-setxkbmap xkill:xorg-xkill
    killall:psmisc ip:iproute2 jq curl
    cava xwinwrap:xwinwrap-git mpv wal:python-pywal16 skippy-xd:skippy-xd-git
    mpd mpc ncmpcpp pactl:libpulse fcitx5
    alacritty nvim:neovim tmux ranger zsh
  )
fi
missing=()
for entry in "${checks[@]}"; do
  cmd=${entry%%:*} pkg=${entry#*:}
  command -v "$cmd" >/dev/null || missing+=("$pkg")
done
# Brightness backend is selected from the current hardware, not the hostname.
if [ "$(uname)" = Linux ]; then
  if [ -n "$("$DOTFILES/i3/.config/i3/bin/hardware" backlight-device)" ]; then
    command -v brightnessctl >/dev/null || command -v light >/dev/null || missing+=(brightnessctl)
  else
    command -v ddcutil >/dev/null || missing+=(ddcutil)
  fi
fi
# Ghostty.app puts no command on PATH
[ "$(uname)" = Darwin ] && { [ -d /Applications/Ghostty.app ] || missing+=(ghostty); }
if [ "$(uname)" = Linux ]; then
  [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ] || missing+=(polkit-gnome)
  # Python modules for the i3 scripts (they run /usr/bin/python3, not a conda python)
  /usr/bin/python3 -c 'import i3ipc' 2>/dev/null || missing+=(python-i3ipc)
  /usr/bin/python3 -c 'import Xlib' 2>/dev/null || missing+=(python-xlib)
fi
# Commands this host's i3 overrides launch (e.g. ddcutil on the desktop, light on the ThinkPad)
host_i3="$DOTFILES/hosts/$HOST/.config/dotfiles-host/i3.conf"
if [ -r "$host_i3" ]; then
  while read -r cmd; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
  done < <(grep -oE '^[^#]*exec (--no-startup-id )?[^ "]+' "$host_i3" | awk '{print $NF}' | sort -u)
fi

if [ ${#missing[@]} -gt 0 ]; then
  echo
  echo "not installed on this machine: ${missing[*]}"
  echo "  (the configs degrade gracefully, but those features stay dead; see INSTALL.md)"
fi

# Non-zero when a package was not linked, so bin/dotfiles-apply reports it
[ ${#FAILED[@]} -eq 0 ]
