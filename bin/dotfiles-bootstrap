#!/usr/bin/env bash
# Install these dotfiles on the current machine.
#
#   bin/dotfiles-bootstrap            # stow generic packages + this host's overrides
#   bin/dotfiles-bootstrap -n         # dry run, show what would change
#   bin/dotfiles-bootstrap -R         # restow (fix up links after adding/removing files)
#   bin/dotfiles-bootstrap -D         # uninstall
#   DOTFILES_HOST=other bin/dotfiles-bootstrap   # pretend to be another host
#
# Everything is stowed into $HOME, resolved at run time -- so this works under
# any username, unlike a .stowrc with a hardcoded --target.
set -euo pipefail

DOTFILES="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
HOST="${DOTFILES_HOST:-$(hostname)}"
# Untracked editor state can sit inside any package (e.g. mpd/.vscode); never link it into $HOME
STOW_FLAGS=(--target="$HOME" --ignore='\.history' --ignore='\.vscode' --ignore='\.idea')
ACTION="--stow"

while getopts ':nRDh' opt; do
  case "$opt" in
    n) STOW_FLAGS+=(--no --verbose) ;;
    R) ACTION="--restow" ;;
    D) ACTION="--delete" ;;
    h) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option -$OPTARG (try -h)" >&2; exit 2 ;;
  esac
done

command -v stow >/dev/null || { echo "GNU stow is not installed" >&2; exit 1; }

# Generic packages = every top-level directory that is not infrastructure.
# Hidden directories are skipped too: .git, and untracked editor state such as
# .history (VS Code local history) or .vscode, which would otherwise be stowed into $HOME.
mapfile -t PACKAGES < <(
  find "$DOTFILES" -mindepth 1 -maxdepth 1 -type d -not -name '.*' -printf '%f\n' \
    | grep -vxE 'hosts|bin' | sort
)
# Mac-only packages are skipped elsewhere
if [ "$(uname)" != Darwin ]; then
  mapfile -t PACKAGES < <(printf '%s\n' "${PACKAGES[@]}" | grep -vxE 'aerospace')
fi
[ ${#PACKAGES[@]} -gt 0 ] || { echo "no packages found in $DOTFILES" >&2; exit 1; }

echo "dotfiles : $DOTFILES"
echo "target   : $HOME"
echo "host     : $HOST"
echo "packages : ${PACKAGES[*]}"
echo

stow "${STOW_FLAGS[@]}" --dir="$DOTFILES" "$ACTION" "${PACKAGES[@]}"

# Per-machine overrides. Absent is fine: every include hook in the generic
# configs tolerates a missing file (i3 `include`, alacritty `import`,
# mpd `include_optional`, the `[[ -r ]]` guard in .zshrc).
if [ -d "$DOTFILES/hosts/$HOST" ]; then
  stow "${STOW_FLAGS[@]}" --dir="$DOTFILES/hosts" "$ACTION" "$HOST"
  echo "host overrides: applied hosts/$HOST"
else
  echo "host overrides: none for '$HOST' (generic config only)"
  echo "  to add some:  mkdir -p hosts/$HOST/.config/dotfiles-host"
  echo "  available  : $(find "$DOTFILES/hosts" -mindepth 1 -maxdepth 1 -type d -printf '%f ' 2>/dev/null)"
fi

[ "$ACTION" = "--delete" ] && exit 0

# Report anything the configs and scripts use that is not installed here, as package names
# (command:package, or just the command when the package has the same name). Keep in sync
# with INSTALL.md.
checks=(
  i3:i3-wm polybar picom rofi rofimoji dunst conky i3lock:i3lock-color xss-lock autotiling
  nitrogen udiskie xsettingsd copyq flameshot xfce4-power-manager nm-applet:network-manager-applet
  blueman-applet:blueman redshift playerctl notify-send:libnotify flock:util-linux
  xrandr:xorg-xrandr xset:xorg-xset xrdb:xorg-xrdb setxkbmap:xorg-setxkbmap xkill:xorg-xkill
  killall:psmisc ip:iproute2 jq curl
  cava xwinwrap:xwinwrap-git mpv wal:python-pywal16
  mpd mpc ncmpcpp pactl:libpulse fcitx5
  alacritty nvim:neovim tmux ranger zsh
)
missing=()
for entry in "${checks[@]}"; do
  cmd=${entry%%:*} pkg=${entry#*:}
  command -v "$cmd" >/dev/null || missing+=("$pkg")
done
# Brightness backend is selected from the current hardware, not the hostname.
if [ "$(uname)" = Linux ]; then
  if [ -n "$("$DOTFILES/i3/.config/i3/bin/hardware" backlight-device)" ]; then
    command -v brightnessctl >/dev/null || command -v light >/dev/null || missing+=(brightnessctl)
  else
    command -v ddcutil >/dev/null || missing+=(ddcutil)
  fi
fi
[ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ] || missing+=(polkit-gnome)
# Python modules for the i3 scripts (they run /usr/bin/python3, not a conda python)
/usr/bin/python3 -c 'import i3ipc' 2>/dev/null || missing+=(python-i3ipc)
/usr/bin/python3 -c 'import Xlib' 2>/dev/null || missing+=(python-xlib)
# Commands this host's i3 overrides launch (e.g. ddcutil on the desktop, light on the ThinkPad)
host_i3="$DOTFILES/hosts/$HOST/.config/dotfiles-host/i3.conf"
if [ -r "$host_i3" ]; then
  while read -r cmd; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
  done < <(grep -oE '^[^#]*exec (--no-startup-id )?[^ "]+' "$host_i3" | awk '{print $NF}' | sort -u)
fi

if [ ${#missing[@]} -gt 0 ]; then
  echo
  echo "not installed on this machine: ${missing[*]}"
  echo "  (the configs degrade gracefully, but those features stay dead; see INSTALL.md)"
fi
