configuration {
    modes:               "window,combi,ssh,drun";
    combi-modes:         "window,ssh,drun";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    display-combi:       "Search";
    drun-display-format: "{name}";
    window-format:       "{c}  ·  {t}";
}

/* Dark card theme; colours in themes/colors.rasi (Nord, or pywal via ~/.config/i3/bin/theme) */
@theme "~/.config/rofi/themes/card.rasi"
