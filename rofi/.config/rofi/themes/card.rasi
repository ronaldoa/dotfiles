/* Launcher / window switcher / dmenu lists: a dark card in the middle of the screen.
 * The window itself is square and opaque; picom rounds its corners and adds the blur. */

@import "colors.rasi"

* {
    font:             "Noto Sans CJK SC 12";
    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         center;
    width:            640px;
    background-color: @bg;
    padding:          18px;
}

mainbox {
    spacing:  14px;
    children: [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ icon-search, entry ];
}

icon-search {
    expand:   false;
    filename: "search";
    size:     20px;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    vertical-align:    0.5;
}

message {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          10px 14px;
}

textbox {
    text-color: @fg-dim;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    scrollbar:    false;
    fixed-height: false;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 10px;
}

element selected {
    background-color: @bg-sel;
}

element selected.normal, element selected.active {
    text-color: @accent;
}

element urgent, element selected.urgent {
    text-color: @urgent;
}

element-icon {
    size:           24px;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding:       6px;
    border-radius: 10px;
    text-color:    @fg-dim;
}

button selected {
    background-color: @bg-alt;
    text-color:       @accent;
}
