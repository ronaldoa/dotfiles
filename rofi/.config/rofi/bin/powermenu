#!/usr/bin/env bash
# Power menu: a row of big buttons (rofi, themes/buttons.rasi). Everything except Lock asks
# for confirmation with a Yes / No pair of buttons. Bound to Super+Shift+Esc and the polybar power icon.

theme="$HOME/.config/rofi/themes/buttons.rasi"

# Entries are separated by '|' so each button can have the icon and the label on separate lines
# (-eh 3: the big icon takes about two lines of height);
# button <icon> <label> makes one entry with a large Nerd Font icon above the label
button() { printf '<span font="Hack Nerd Font 22">%s</span>\n%s' "$1" "$2"; }

menu() {  # menu <prompt> <columns> <entries...>
    local prompt=$1 columns=$2
    shift 2
    local width=$((columns * 116 + (columns - 1) * 14 + 44))
    local IFS='|'
    printf '%s' "$*" | rofi -dmenu -sep '|' -eh 3 -markup-rows -no-custom -i -format i -mesg "$prompt" -theme "$theme" \
        -theme-str "listview { columns: $columns; } window { width: ${width}px; }"
}

confirm() {
    [ "$(menu "$1?" 2 "$(button  'Yes')" "$(button  'No')")" = 0 ]
}

uptime=$(uptime -p | sed 's/^up //')
choice=$(menu "Up $uptime" 5 \
    "$(button  'Lock')" "$(button  'Sleep')" "$(button  'Log out')" "$(button  'Restart')" "$(button  'Shut down')")

case $choice in
    0) loginctl lock-session ;;
    1) confirm "Sleep" && { mpc -q pause; systemctl suspend; } ;;
    2) confirm "Log out" && i3-msg exit ;;
    3) confirm "Restart" && systemctl reboot ;;
    4) confirm "Shut down" && systemctl poweroff ;;
esac
