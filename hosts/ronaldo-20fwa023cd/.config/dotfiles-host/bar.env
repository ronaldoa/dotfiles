# ThinkPad T460p -- sourced by i3/.config/i3/bin/polybar-launch.
#
# gpu_temp is dropped here: the Skylake HD530 has no hwmon directory under
# /sys/class/drm/card*/device, so `hardware gpu-temp` prints nothing and Polybar
# renders no module at all -- which also removes the click target that opens the
# GPU card. The `gpu` module shows the adapter name ("Intel") instead and carries
# the same click-left = hardware gpu-info.
BAR_LEFT='i3 cpu_temp gpu memory'
