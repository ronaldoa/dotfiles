# Desktop (RTX 4060 Ti) -- sourced by i3/.config/i3/bin/i3bar.
#
# Same as the built-in default; spelled out so the difference from the ThinkPad,
# which has no GPU temperature sensor and shows the adapter name instead, is
# visible in both host directories rather than only in one.
BAR_LEFT='i3 cpu_temp gpu_temp memory'
